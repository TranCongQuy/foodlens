# DrawToStory Frontend Environment Configuration
# Note: Never place GEMINI_API_KEY in frontend .env — configure it in Supabase Edge Function Secrets!
VITE_USE_MOCK=false
VITE_ENABLE_QUICK_LOGIN=true
# FoodLens backend: để trống hoặc 'supabase' = gọi Edge Function analyze-food thật;
# 'local' = bộ phân tích mẫu phía client (chỉ dev/test UI, lịch sử lưu localStorage)
VITE_FOODLENS_BACKEND=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
